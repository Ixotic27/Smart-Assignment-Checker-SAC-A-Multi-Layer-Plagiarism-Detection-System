<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sac.LoginController" style="-fx-padding: 40; -fx-background-color: #f4f4f4;">
   
    <Label text="Smart Assignment Checker" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>
    
    <VBox spacing="10.0" maxWidth="300">
        <Label text="Username:">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>
        <TextField fx:id="usernameField" promptText="Enter your username" 
                   style="-fx-font-size: 14px; -fx-padding: 8px;"/>
        
        <Label text="Password:">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>
        <PasswordField fx:id="passwordField" promptText="Enter your password" 
                       style="-fx-font-size: 14px; -fx-padding: 8px;"/>
    </VBox>
    
    <Button text="Login" onAction="#handleLogin" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-cursor: hand;" />
    
</VBox>
